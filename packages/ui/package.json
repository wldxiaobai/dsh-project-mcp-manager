{
  "name": "dsh-project-mcp-ui",
  "version": "0.8.0",
  "private": false,
  "description": "Settings component included by dsh-project-mcp-manager. Same-version peer of the loader; disable mcp-project-ui to hide the page.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && node build-client.mjs",
    "test": "node --experimental-strip-types test/panel-helpers.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "dsh-project-mcp-manager": "0.8.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-native-command": "^0.2.0-rc.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@types/react": "~18.3.1",
    "dsh-project-mcp-manager": "workspace:0.8.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
